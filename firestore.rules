rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all (denies any future/unlisted collection by default)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSecretary() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isViewer() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 150 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function viewerConfigExists() {
      return exists(/databases/$(database)/documents/viewer_settings/config);
    }

    function viewerConfig() {
      return get(/databases/$(database)/documents/viewer_settings/config).data;
    }

    function hasViewerUnlockDoc() {
      return exists(/databases/$(database)/documents/viewer_unlocks/$(request.auth.uid));
    }

    function viewerUnlockDoc() {
      return get(/databases/$(database)/documents/viewer_unlocks/$(request.auth.uid)).data;
    }

    function isViewerUnlocked() {
      return isViewer() && viewerConfigExists() && (
        viewerConfig().mode == 'open' ||
        (
          viewerConfig().mode == 'passcode' &&
          viewerConfig().passcode is string &&
          viewerConfig().passcode.size() == 6 &&
          hasViewerUnlockDoc() &&
          viewerUnlockDoc().passcodeVersion == viewerConfig().passcodeVersion &&
          viewerUnlockDoc().code == viewerConfig().passcode
        )
      );
    }

    function isValidViewerUnlock(data) {
      return data.keys().hasAll(['code', 'passcodeVersion', 'updatedAt']) &&
        data.keys().hasOnly(['code', 'passcodeVersion', 'updatedAt']) &&
        data.code is string &&
        data.code.size() == 6 &&
        data.code.matches('^[0-9]{6}$') &&
        data.passcodeVersion is int &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 64;
    }

    function viewerPasscodeMatches(data) {
      return viewerConfigExists() &&
        viewerConfig().passcode is string &&
        viewerConfig().passcode.size() == 6 &&
        data.code == viewerConfig().passcode &&
        data.passcodeVersion == viewerConfig().passcodeVersion;
    }

    function isValidViewerNoteCreate(data) {
      return data.keys().hasAll(['message', 'createdAt', 'status']) &&
        data.keys().hasOnly(['message', 'name', 'createdAt', 'status']) &&
        data.message is string &&
        data.message.size() > 0 &&
        data.message.size() <= 500 &&
        data.status == 'new' &&
        data.createdAt is string &&
        data.createdAt.size() > 0 &&
        data.createdAt.size() <= 64 &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100));
    }

    // Health check / connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Public branding & viewer access mode metadata (no passcode, safe for login screen and viewers)
    match /public_branding/{docId} {
      allow read: if true;
      allow write: if isSecretary();
    }

    // Viewer access configuration (Secretary only — viewers can never read viewer_settings)
    match /viewer_settings/{settingId} {
      allow read, write: if isSecretary();
    }

    // Viewer passcode unlock records (document id = viewer's auth uid)
    match /viewer_unlocks/{uid} {
      allow read: if isSecretary() || (isViewer() && request.auth.uid == uid);
      allow create, update: if isSecretary() || (
        isViewer() &&
        request.auth.uid == uid &&
        isValidViewerUnlock(request.resource.data) &&
        viewerPasscodeMatches(request.resource.data)
      );
      allow delete: if isSecretary();
    }

    // Viewer notes (viewers can create only when unlocked, never read; secretary has full access)
    match /viewer_notes/{noteId} {
      allow read, update, delete: if isSecretary();
      allow create: if isSecretary() || (
        isViewerUnlocked() &&
        isValidId(noteId) &&
        isValidViewerNoteCreate(request.resource.data)
      );
    }

    // ---------------- VIEWER READ-ONLY COLLECTIONS (Secretary has full read/write) ----------------

    // Regular recurring services and activities
    match /regular_services/{serviceId} {
      allow read: if isSecretary() || isViewerUnlocked();
      allow write: if isSecretary();
    }

    // Service single-date overrides and cancellations
    match /service_overrides/{overrideId} {
      allow read: if isSecretary() || isViewerUnlocked();
      allow write: if isSecretary();
    }

    // Calendar events and event templates
    match /events/{eventId} {
      allow read: if isSecretary() || isViewerUnlocked();
      allow write: if isSecretary();
    }

    // Schedules (cards representing schedule periods for roles)
    match /schedules/{scheduleId} {
      allow read: if isSecretary() || isViewerUnlocked();
      allow write: if isSecretary();
    }

    // Role roster assignments
    match /assignments/{assignmentId} {
      allow read: if isSecretary() || isViewerUnlocked();
      allow write: if isSecretary();
    }

    // Outline nodes (ministries, groups, roles)
    match /outline_nodes/{nodeId} {
      allow read: if isSecretary() || isViewerUnlocked();
      allow write: if isSecretary();
    }

    // Viewer-safe member copy (name, department, birthday month & day only)
    match /people_public/{personId} {
      allow read: if isSecretary() || isViewerUnlocked();
      allow write: if isSecretary();
    }

    // ---------------- SECRETARY-ONLY COLLECTIONS (Denied to viewers) ----------------

    // App settings
    match /settings/{settingId} {
      allow read, write: if isSecretary();
    }

    // Full member records
    match /people/{personId} {
      allow read, write: if isSecretary();
    }

    // Event categories
    match /categories/{categoryId} {
      allow read, write: if isSecretary();
    }

    // Message templates
    match /message_templates/{templateId} {
      allow read, write: if isSecretary();
    }

    // Sent reminders tracking
    match /sent_reminders/{reminderId} {
      allow read, write: if isSecretary();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read, write: if isSecretary();
    }

    // Task categories
    match /task_categories/{categoryId} {
      allow read, write: if isSecretary();
    }

    // Quick notes
    match /notes/{noteId} {
      allow read, write: if isSecretary();
    }

    // Forerunner Sunday School lessons
    match /forerunner_lessons/{lessonId} {
      allow read, write: if isSecretary();
    }

    // Forerunner format settings
    match /forerunner_settings/{settingId} {
      allow read, write: if isSecretary();
    }

    // Forerunner assets (background image, logos)
    match /forerunner_assets/{assetId} {
      allow read, write: if isSecretary();
    }

    // Forerunner Sunday bulletins
    match /forerunner_bulletins/{bulletinId} {
      allow read, write: if isSecretary();
    }

    // First-time and returning church visitors
    match /visitors/{visitorId} {
      allow read, write: if isSecretary();
    }

    // Visitor analytics age group settings
    match /visitor_settings/{settingId} {
      allow read, write: if isSecretary();
    }
  }
}
